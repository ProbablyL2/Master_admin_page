<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" stylesheets="@../style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.TeacherDetailController">
   <content>
      <VBox fx:id="contentContainer" spacing="16.0" style="-fx-background-color: #f1f5f9; -fx-padding: 24;">
         <children>
            <!-- Top Action Bar -->
            <HBox fx:id="topActionBar" alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleReturn" prefHeight="35.0" prefWidth="100.0" styleClass="reset-button" text="← Return" />
                  <Pane HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnReset" mnemonicParsing="false" onAction="#handleResetData" prefHeight="35.0" prefWidth="110.0" styleClass="reset-button" text="Reset Data" />
                  <Button fx:id="btnSave" mnemonicParsing="false" onAction="#handleSave" prefHeight="35.0" prefWidth="140.0" styleClass="search-button" text="Save Changes" />
               </children>
            </HBox>

            <!-- 1. Standalone Top Header Block (Title & Passport Photo) -->
            <VBox style="-fx-background-color: white; -fx-padding: 18 22; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <VBox spacing="3.0">
                           <children>
                              <Label fx:id="lblFormTitle" text="FACULTY / TEACHER INFORMATION FORM" textFill="#1e3a8a">
                                 <font><Font name="System Bold" size="18.0" /></font>
                              </Label>
                              <Label text="EXCELLENCE  •  RESEARCH  •  INSTRUCTION" textFill="#d97706">
                                 <font><Font name="System Bold" size="10.5" /></font>
                              </Label>
                           </children>
                        </VBox>
                        <Pane HBox.hgrow="ALWAYS" />
                        <VBox alignment="CENTER" spacing="4.0">
                           <children>
                              <VBox fx:id="photoContainer" alignment="CENTER" onMouseClicked="#handleUploadPhoto"
                                    prefHeight="115.0" prefWidth="90.0" maxHeight="115.0" maxWidth="90.0" minHeight="115.0" minWidth="90.0"
                                    style="-fx-border-color: #1e3a8a; -fx-border-width: 1.5; -fx-background-color: #f8fafc; -fx-border-radius: 4; -fx-cursor: hand;">
                                 <children>
                                    <ImageView fx:id="passportImageView" fitHeight="110.0" fitWidth="86.0" pickOnBounds="true" preserveRatio="false">
                                       <image>
                                          <Image url="@../freddy.jpg" />
                                       </image>
                                    </ImageView>
                                 </children>
                              </VBox>
                              <Label fx:id="lblPhotoAction" onMouseClicked="#handleUploadPhoto" text="📷 Change Photo" textFill="#2563eb" style="-fx-cursor: hand; -fx-font-size: 10px; -fx-font-weight: bold;" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>

            <!-- 2. Excel Import Box (Browse + Drag & Drop - Visible on Add Mode) -->
            <VBox fx:id="importBox" spacing="10.0" style="-fx-background-color: white; -fx-padding: 14 20; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Label text="📊" textFill="#1e3a8a">
                           <font><Font size="16.0" /></font>
                        </Label>
                        <Label text="Import from Excel / CSV" textFill="#1e3a8a">
                           <font><Font name="System Bold" size="13.0" /></font>
                        </Label>
                        <Label text="(Automatically pre-fill teacher form details from a spreadsheet)" textFill="#64748b">
                           <font><Font size="11.5" /></font>
                        </Label>
                     </children>
                  </HBox>

                  <!-- Browse Bar -->
                  <HBox alignment="CENTER_LEFT" spacing="10.0">
                     <children>
                        <TextField fx:id="txtExcelPath" editable="false" promptText="Select or drop a Teacher spreadsheet (.xlsx, .csv)..." prefHeight="36.0" HBox.hgrow="ALWAYS"
                                   style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 12; -fx-text-fill: #334155;" />
                        <Button mnemonicParsing="false" onAction="#handleBrowseExcel" prefHeight="36.0" prefWidth="105.0"
                                text="📂 Browse..."
                                style="-fx-background-color: #e2e8f0; -fx-text-fill: #334155; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
                        <Button mnemonicParsing="false" onAction="#handleImportExcel" prefHeight="36.0" prefWidth="120.0"
                                text="📥 Import Data"
                                style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" />
                     </children>
                  </HBox>

                  <!-- Drag & Drop Zone Area -->
                  <VBox fx:id="dropZone" alignment="CENTER" prefHeight="68.0" spacing="4.0"
                        onDragOver="#handleDragOver" onDragDropped="#handleDragDropped" onDragExited="#handleDragExited"
                        style="-fx-border-color: #94a3b8; -fx-border-width: 1.5; -fx-border-style: dashed; -fx-border-radius: 6; -fx-background-color: #f8fafc; -fx-background-radius: 6; -fx-cursor: hand;">
                     <children>
                        <Label text="📁 Drag &amp; Drop your Faculty Excel or CSV file here" textFill="#1e40af">
                           <font><Font name="System Bold" size="12.0" /></font>
                        </Label>
                        <Label text="Supports .xlsx and .csv spreadsheets — will automatically read and populate details" textFill="#64748b">
                           <font><Font size="10.5" /></font>
                        </Label>
                     </children>
                  </VBox>
               </children>
            </VBox>

            <!-- 3. Main Form Sheet Container (Form Details) -->
            <VBox spacing="14.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 8; -fx-border-color: #cbd5e1; -fx-border-radius: 8;">
               <children>
                  <!-- 1. Teacher Details Section -->
                  <Label style="-fx-background-color: #1e3a8a; -fx-text-fill: white; -fx-padding: 5 18; -fx-background-radius: 15;" text="1. Teacher Details">
                     <font><Font name="System Bold" size="11.5" /></font>
                  </Label>
                  <GridPane fx:id="gridTeacherDetails" hgap="12.0" vgap="10.0">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="130.0" minWidth="100.0" prefWidth="120.0" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="15.0" minWidth="15.0" prefWidth="15.0" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="210.0" minWidth="140.0" prefWidth="195.0" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="130.0" minWidth="100.0" prefWidth="120.0" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="15.0" minWidth="15.0" prefWidth="15.0" />
                      <ColumnConstraints hgrow="SOMETIMES" maxWidth="210.0" minWidth="140.0" prefWidth="195.0" />
                    </columnConstraints>
                    <rowConstraints>
                      <RowConstraints minHeight="26.0" prefHeight="26.0" />
                      <RowConstraints minHeight="26.0" prefHeight="26.0" />
                      <RowConstraints minHeight="26.0" prefHeight="26.0" />
                      <RowConstraints minHeight="26.0" prefHeight="26.0" />
                    </rowConstraints>
                     <children>
                        <Label text="Teacher ID" /><Label text=":" GridPane.columnIndex="1" /><Label fx:id="lblTeacherId" style="-fx-border-color: #94a3b8; -fx-border-width: 0 0 1 0;" GridPane.columnIndex="2" />
                        <Label text="Date of Birth" GridPane.columnIndex="3" /><Label text=":" GridPane.columnIndex="4" /><Label fx:id="lblDob" style="-fx-border-color: #94a3b8; -fx-border-width: 0 0 1 0;" GridPane.columnIndex="5" />
                        
                        <Label text="Full Name" GridPane.rowIndex="1" /><Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="1" /><Label fx:id="lblName" style="-fx-border-color: #94a3b8; -fx-border-width: 0 0 1 0;" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <Label text="Gender" GridPane.columnIndex="3" GridPane.rowIndex="1" /><Label text=":" GridPane.columnIndex="4" GridPane.rowIndex="1" /><Label fx:id="lblGender" style="-fx-border-color: #94a3b8; -fx-border-width: 0 0 1 0;" GridPane.columnIndex="5" GridPane.rowIndex="1" />
                        
                        <Label text="Department" GridPane.rowIndex="2" /><Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="2" /><Label fx:id="lblDept" style="-fx-border-color: #94a3b8; -fx-border-width: 0 0 1 0;" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                        <Label text="Nationality" GridPane.columnIndex="3" GridPane.rowIndex="2" /><Label text=":" GridPane.columnIndex="4" GridPane.rowIndex="2" /><Label fx:id="lblNationality" style="-fx-border-color: #94a3b8; -fx-border-width: 0 0 1 0;" GridPane.columnIndex="5" GridPane.rowIndex="2" />
                        
                        <Label text="Position" GridPane.rowIndex="3" /><Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="3" /><Label fx:id="lblPosition" style="-fx-border-color: #94a3b8; -fx-border-width: 0 0 1 0;" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                        <Label text="NRC / ID No." GridPane.columnIndex="3" GridPane.rowIndex="3" /><Label text=":" GridPane.columnIndex="4" GridPane.rowIndex="3" /><Label fx:id="lblNrc" style="-fx-border-color: #94a3b8; -fx-border-width: 0 0 1 0;" GridPane.columnIndex="5" GridPane.rowIndex="3" />
                     </children>
                  </GridPane>

                  <!-- 2. Contact Information Section -->
                  <Label style="-fx-background-color: #1e3a8a; -fx-text-fill: white; -fx-padding: 5 18; -fx-background-radius: 15;" text="2. Contact Information">
                     <font><Font name="System Bold" size="11.5" /></font>
                  </Label>
                  <GridPane fx:id="gridContactInfo" hgap="12.0" vgap="10.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="130.0" minWidth="100.0" prefWidth="120.0" />
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="15.0" minWidth="15.0" prefWidth="15.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="450.0" prefWidth="535.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="26.0" prefHeight="26.0" />
                        <RowConstraints minHeight="26.0" prefHeight="26.0" />
                        <RowConstraints minHeight="26.0" prefHeight="26.0" />
                        <RowConstraints minHeight="26.0" prefHeight="26.0" />
                     </rowConstraints>
                     <children>
                        <Label text="Phone Number" /><Label text=":" GridPane.columnIndex="1" /><Label fx:id="lblPhone" style="-fx-border-color: #94a3b8; -fx-border-width: 0 0 1 0;" GridPane.columnIndex="2" />
                        <Label text="Email Address" GridPane.rowIndex="1" /><Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="1" /><Label fx:id="lblEmail" style="-fx-border-color: #94a3b8; -fx-border-width: 0 0 1 0;" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <Label text="Current Address" GridPane.rowIndex="2" /><Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="2" /><Label fx:id="lblCurrentAddress" style="-fx-border-color: #94a3b8; -fx-border-width: 0 0 1 0;" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                        <Label text="Permanent Address" GridPane.rowIndex="3" /><Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="3" /><Label fx:id="lblPermanentAddress" style="-fx-border-color: #94a3b8; -fx-border-width: 0 0 1 0;" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                     </children>
                  </GridPane>

                  <!-- 3. Academic & Professional Background Section -->
                  <Label style="-fx-background-color: #1e3a8a; -fx-text-fill: white; -fx-padding: 5 18; -fx-background-radius: 15;" text="3. Academic &amp; Professional Background">
                     <font><Font name="System Bold" size="11.5" /></font>
                  </Label>
                  <GridPane fx:id="gridAcademicInfo" hgap="12.0" vgap="10.0">
                     <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="155.0" minWidth="130.0" prefWidth="145.0" />
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="15.0" minWidth="15.0" prefWidth="15.0" />
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="450.0" prefWidth="510.0" />
                     </columnConstraints>
                     <rowConstraints>
                        <RowConstraints minHeight="26.0" prefHeight="26.0" />
                        <RowConstraints minHeight="26.0" prefHeight="26.0" />
                        <RowConstraints minHeight="26.0" prefHeight="26.0" />
                        <RowConstraints minHeight="26.0" prefHeight="26.0" />
                        <RowConstraints minHeight="26.0" prefHeight="26.0" />
                     </rowConstraints>
                     <children>
                        <Label text="Highest Degree" /><Label text=":" GridPane.columnIndex="1" /><Label fx:id="lblDegree" style="-fx-border-color: #94a3b8; -fx-border-width: 0 0 1 0;" GridPane.columnIndex="2" />
                        <Label text="University / Institution" GridPane.rowIndex="1" /><Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="1" /><Label fx:id="lblUniversity" style="-fx-border-color: #94a3b8; -fx-border-width: 0 0 1 0;" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                        <Label text="Year Completed" GridPane.rowIndex="2" /><Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="2" /><Label fx:id="lblYearCompleted" style="-fx-border-color: #94a3b8; -fx-border-width: 0 0 1 0;" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                        <Label text="Specialization / Area" GridPane.rowIndex="3" /><Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="3" /><Label fx:id="lblSpecialization" style="-fx-border-color: #94a3b8; -fx-border-width: 0 0 1 0;" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                        <Label text="Emergency Contact" GridPane.rowIndex="4" /><Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="4" /><Label fx:id="lblEmergency" style="-fx-border-color: #94a3b8; -fx-border-width: 0 0 1 0;" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                     </children>
                  </GridPane>
               </children>
            </VBox>
         </children>
      </VBox>
   </content>
</ScrollPane>