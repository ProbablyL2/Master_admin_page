<ScrollPane fitToWidth="true" prefHeight="700.0" prefWidth="760.0" style="-fx-background: #f4f6f9; -fx-background-color: #f4f6f9;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.DashboardController">
