<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="rootPane" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="700.0" prefWidth="760.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.TeacherController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <!-- Top Search Bar & Reset Button -->
      <VBox spacing="10.0">
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="700.0" spacing="10.0">
               <children>
                  <TextField fx:id="searchField" prefHeight="38.0" prefWidth="540.0" promptText="Search name, department, position, or phone..." style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-color: white;" HBox.hgrow="ALWAYS" />
                  <Button fx:id="searchBtn" mnemonicParsing="false" onAction="#handleSearch" prefHeight="38.0" prefWidth="75.0" styleClass="search-button" text="Search" />
                  <Button fx:id="resetBtn" mnemonicParsing="false" onAction="#handleReset" prefHeight="38.0" prefWidth="65.0" styleClass="reset-button" text="Reset" />
               </children>
            </HBox>
         </children>
         <VBox.margin>
            <Insets bottom="15.0" />
         </VBox.margin>
      </VBox>
      
      <!-- Table View -->
      <TableView fx:id="teacherTable" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="440.0" prefWidth="700.0" style="-fx-background-radius: 6; -fx-border-color: #cbd5e1; -fx-border-radius: 6;" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colNo" prefWidth="45.0" text="No" />
          <TableColumn fx:id="colName" prefWidth="135.0" text="Name" />
          <TableColumn fx:id="colDepartment" prefWidth="175.0" text="" />
          <TableColumn fx:id="colPosition" prefWidth="175.0" text="" />
          <TableColumn fx:id="colPhone" prefWidth="115.0" text="Phone-no" />
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
      
      <!-- Bottom Action Buttons -->
      <HBox alignment="CENTER" prefHeight="60.0" prefWidth="700.0" styleClass="buttoncontainer">
         <children>
            <Button fx:id="modify" mnemonicParsing="false" onAction="#handleModify" prefHeight="45.0" prefWidth="135.0" styleClass="rounded-button" text="Modify" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="add" mnemonicParsing="false" onAction="#handleAdd" prefHeight="45.0" prefWidth="200.0" styleClass="rounded-button" text="+ Add Teacher">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="remove" mnemonicParsing="false" onAction="#handleRemove" prefHeight="45.0" prefWidth="135.0" styleClass="rounded-button" text="Remove" />
         </children>
         <VBox.margin>
            <Insets top="20.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>